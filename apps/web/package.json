  "version": "0.1.0",
  "private": true,
  "description": "FilePrism free ad-supported web converter (WASM + SEO landings)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
