<?xml version="1.0" encoding="utf-8"?>
<!--
  FilePrism sparse package for unpackaged (Win32 / Tauri) installs.
  Gives the desktop app package identity so Explorer can load the
  IExplorerCommand COM DLL registered below.

  CLSID: {8F3A2B1C-6D4E-4F9A-9B2C-1E5D7A8F3C4E}
  DLL relative path (install layout): shell\fileprism_explorer_win.dll

  Dev registration: packaging/windows/register-sparse-package.ps1
  Production signing + identity: M7 packaging milestone.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap uap2 uap3 com desktop desktop4 desktop5 rescap uap10">

  <Identity
    Name="FilePrism.Shell"
    Publisher="CN=FilePrism Dev"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>FilePrism</DisplayName>
    <PublisherDisplayName>FilePrism</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="FilePrism"
      Executable="FilePrism.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="FilePrism"
        Description="Local-first file conversion and compression"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- COM server hosting IExplorerCommand -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="FilePrism Explorer Command">
              <com:Class
                Id="8F3A2B1C-6D4E-4F9A-9B2C-1E5D7A8F3C4E"
                Path="shell\fileprism_explorer_win.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Modern context menu (Windows 11+) -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb
                Id="FilePrismOpen"
                Clsid="8F3A2B1C-6D4E-4F9A-9B2C-1E5D7A8F3C4E" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb
                Id="FilePrismOpenDir"
                Clsid="8F3A2B1C-6D4E-4F9A-9B2C-1E5D7A8F3C4E" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
